# ─── Neon Postgres ──────────────────────────────────────────────────────────
# Neon dashboard → your project → Connect → pooled connection string.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ─── Vercel Blob ────────────────────────────────────────────────────────────
# All three are injected automatically when you connect a Blob store to the
# project. Copy them from the store's Quickstart → .env.local tab for local dev.
#
# Uploads use the presigned flow, which authenticates with OIDC: on Vercel that
# is VERCEL_OIDC_TOKEN (supplied by the platform) plus BLOB_STORE_ID. No
# long-lived read-write token is needed there, and revoking it is safe.
BLOB_STORE_ID="store_xxxxxxxx"

# Verifies the Ed25519 signature on upload-completed callbacks. The upload
# route refuses to start without it, locally included.
BLOB_WEBHOOK_PUBLIC_KEY=""

# Local dev only: there is no OIDC token off-platform, so the SDK falls back to
# this for issuing signed tokens. Leave it out of the Vercel project.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# ─── Transcription ──────────────────────────────────────────────────────────
ASSEMBLYAI_API_KEY=""

# Optional. Selects the adapter in lib/transcription/. Defaults to assemblyai.
# TRANSCRIPTION_PROVIDER="assemblyai"

# ─── AI analysis via Vercel AI Gateway ──────────────────────────────────────
# One key, any model. On Vercel, OIDC can replace this entirely.
AI_GATEWAY_API_KEY=""

# Any model string the gateway accepts. Swapping models is a config change.
AI_ANALYSIS_MODEL="anthropic/claude-sonnet-5"

# ─── App ────────────────────────────────────────────────────────────────────
# Production origin. The transcription provider posts its webhook here, so it
# must be the production domain — preview deployments sit behind Vercel
# Authentication and will reject the callback. On Vercel this is derived
# automatically from VERCEL_PROJECT_PRODUCTION_URL if left unset.
APP_URL="https://signal.colinkline.com"

# Shared secret the provider echoes back in a header, so forged webhook calls
# are rejected. Any long random string.
TRANSCRIPTION_WEBHOOK_SECRET=""

# You generate this one — Vercel does not create it for you. Any long random
# string (openssl rand -hex 32). Vercel then sends it as an Authorization
# bearer token on every cron invocation, and /api/cron/retention rejects
# anything else. Leaving it unset leaves the daily retention sweep open to
# anyone who knows the path.
CRON_SECRET=""
